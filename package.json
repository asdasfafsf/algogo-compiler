{
  "name": "algogo-compiler",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "NODE_ENV=development nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "lint:fix": "pnpm lint --fix",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:all": "pnpm typecheck && pnpm lint && pnpm build && pnpm test --runInBand && pnpm test:integration && pnpm test:e2e",
    "test:local": "docker compose -f compose.test.yml up --build --abort-on-container-exit --exit-code-from tests"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "bullmq": "^5.58.5",
    "joi": "^17.13.6",
    "nest-winston": "^1.10.2",
    "pidusage": "^3.0.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@babel/core@<8": "7.29.6",
      "@babel/helpers@<8": "7.29.2",
      "ajv@<7": "6.14.0",
      "ajv@>=7 <9": "8.18.0",
      "body-parser@<2": "1.20.6",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "browserslist@<5": "4.28.7",
      "diff@>=4 <5": "4.0.4",
      "fast-uri@>=3 <4": "3.1.6",
      "flatted@<4": "3.4.2",
      "form-data@>=4 <5": "4.0.6",
      "formidable@>=3 <4": "3.5.3",
      "glob@>=10 <11": "10.5.0",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "lodash@>=4 <5": "4.18.0",
      "minimatch@<4": "3.1.4",
      "minimatch@>=5 <6": "5.1.8",
      "minimatch@>=9 <10": "9.0.7",
      "multer@<3": "2.3.0",
      "path-to-regexp@<1": "0.1.13",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "qs@>=6 <7": "6.16.0",
      "serialize-javascript@>=5 <8": "7.0.5",
      "tmp@<1": "0.2.6",
      "uuid@<12": "11.1.1",
      "webpack@>=5 <6": "5.104.1"
    }
  }
}
